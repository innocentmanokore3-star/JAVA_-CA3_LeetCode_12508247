class FooBar {
    private final int n;
    private boolean fooTurn = true;
    private final Object monitor = new Object();

    public FooBar(int n) {
        this.n = n;
    }

    public void foo(Runnable printFoo) throws InterruptedException {
        for (int i = 0; i < n; i++) {
            synchronized (monitor) {
                while (!fooTurn) {
                    monitor.wait();
                }
                printFoo.run();
                fooTurn = false;
                monitor.notify();
            }
        }
    }

    public void bar(Runnable printBar) throws InterruptedException {
        for (int i = 0; i < n; i++) {
            synchronized (monitor) {
                while (fooTurn) {
                    monitor.wait();
                }
                printBar.run();
                fooTurn = true;
                monitor.notify();
            }
        }
    }
}
