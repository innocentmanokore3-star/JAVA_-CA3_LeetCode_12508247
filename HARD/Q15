class Solution {
    public int firstMissingPositive(int[] nums) {
        int n = nums.length;

        // Place each positive number x (where 1 <= x <= n) at index x - 1
        for (int i = 0; i < n; i++) {
            while (nums[i] >= 1 && nums[i] <= n && nums[nums[i] - 1] != nums[i]) {
                int targetIndex = nums[i] - 1;
                int temp = nums[targetIndex];
                nums[targetIndex] = nums[i];
                nums[i] = temp;
            }
        }

        // First index i where nums[i] != i + 1 reveals missing positive (i + 1)
        for (int i = 0; i < n; i++) {
            if (nums[i] != i + 1) {
                return i + 1;
            }
        }

        return n + 1;
    }
}
